# Enforcement surface: changes need a human code owner.
# Pair with branch protection: "Require review from Code Owners".
# Replace @OWNER with a real GitHub user or team.

/CODEOWNERS            @OWNER
/.github/              @OWNER
/AGENTS.md             @OWNER
/CLAUDE.md             @OWNER
/.claude/              @OWNER
/.agents/              @OWNER
/.githooks/            @OWNER

# Workspace members, lint levels, toolchain, dependency policy
/Cargo.toml            @OWNER
/rust-toolchain.toml   @OWNER
/clippy.toml           @OWNER
/deny.toml             @OWNER
# Cargo's own configuration: a test runner, [env] or profile overrides there change what the gates check
/.cargo/               @OWNER

# Module shape, the arch checker and the recorded settings; gates and pinned tools
/arch/                 @OWNER
/scripts/              @OWNER
/tools.toml            @OWNER

# Verification: journeys and what they prove
/feature-map/                      @OWNER
/crates/app/tests/journeys.rs      @OWNER
# The composition root: which real services the app wires in
/crates/app/src/                   @OWNER
# The release build's smoke run
/crates/app/smoke.toml              @OWNER
