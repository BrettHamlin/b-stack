# Enforcement surface: changes need a human code owner.
# GitHub enforces this only with the default branch's ruleset requiring code-owner review (the new-project skill sets
# it; CI fails without it, scripts/branch_rules.py). Agents act as a separate GitHub user, so the owner's approval counts.
# Replace @OWNER with a real GitHub user or team.

/CODEOWNERS               @OWNER
/.github/                 @OWNER
/AGENTS.md                @OWNER
/CLAUDE.md                @OWNER
/.claude/                 @OWNER
/.agents/                 @OWNER
/.githooks/               @OWNER

# Build settings, tools, libraries and their checksums
/settings.gradle.kts      @OWNER
/build.gradle.kts         @OWNER
/gradle.properties        @OWNER
/gradle/                  @OWNER
/build-logic/             @OWNER
/tools.toml               @OWNER

# Module shape, detekt config and rules, Konsist tests; gates
/arch/                    @OWNER
/scripts/                 @OWNER

# Typed UI identifiers: who may declare them, and how views tag elements
/core/src/commonMain/kotlin/core/UiId.kt  @OWNER
/core-ui/                 @OWNER

# Verification: what journeys can do and the driver that runs them
/verify/journeykit/       @OWNER
/verify/runner/src/main/kotlin/runner/Driver.kt  @OWNER

# Not owned, because every feature edits them: feature-map/, verify/journeys/, fixtures/, app/, app-verify/ and the
# generated adapters (verify/runner/.../Journeys.kt, which the verify gate requires to be exactly what it generates).
# The verify gate fails if a journey or feature the base branch has is gone, unless arch/retired.toml lists it.
