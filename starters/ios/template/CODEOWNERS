# Enforcement surface: changes need a human code owner.
# Pair with branch protection: "Require review from Code Owners".
# Replace @OWNER with a real GitHub user or team.

/CODEOWNERS            @OWNER
/.github/              @OWNER
/AGENTS.md             @OWNER
/CLAUDE.md             @OWNER
/.claude/              @OWNER
/.githooks/            @OWNER

# Project structure, compiler settings, module dependencies
/Project.swift         @OWNER
/Tuist.swift           @OWNER
# Module shape (ModuleShape.swift) and packages. Features.swift, the feature list, has no owner: agents add
# features and links inside the shape there, and the harmonize gate checks the project against it.
/Tuist/                @OWNER
/Tuist/ProjectDescriptionHelpers/Features.swift

# Gates, their configuration and pinned tools
/scripts/              @OWNER
/tools.toml            @OWNER
/.swiftlint.yml        @OWNER
/.harmonize.yaml       @OWNER
/Rules/                @OWNER

# Verification: journeys, what they prove, and the test-mode wiring they run against
/feature-map/                 @OWNER
/Targets/AppVerify/           @OWNER
/Targets/JourneyKit/          @OWNER
/Targets/AppVerifyJourneys/    @OWNER
/Targets/AppVerifyUITests/    @OWNER
/Targets/Fixtures/            @OWNER
# The shipped app's composition root: which real services it passes (journeys run AppVerify, not App)
/Targets/App/                 @OWNER
# Identifiers: UIID (Core) and each feature's <Feature>UIID constants
/Targets/Core/                @OWNER
/Targets/*Interface/          @OWNER
/.agents/                     @OWNER
