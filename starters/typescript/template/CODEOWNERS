# Enforcement surface: changes need a human code owner.
# GitHub enforces this only with the default branch's ruleset requiring code-owner review (the new-project skill sets
# it; CI fails without it, scripts/branch_rules.py). Agents act as a separate GitHub user, so the owner's approval counts.
# Replace @OWNER with a real GitHub user or team.

/CODEOWNERS               @OWNER
/.github/                 @OWNER
/AGENTS.md                @OWNER
/CLAUDE.md                @OWNER
/.claude/                 @OWNER
/.agents/                 @OWNER
/.githooks/               @OWNER

# Workspace and tools
/package.json             @OWNER
/pnpm-workspace.yaml      @OWNER
/tools.toml               @OWNER

# Compiler, lint and test settings
/tsconfig.base.json       @OWNER
/tsconfig.effect.json     @OWNER
/vite.config.ts           @OWNER
/apps/desktop/vite.config.ts  @OWNER
/apps/web/vite.config.ts      @OWNER

# Module shape, per-role compiler settings, lint rules; gates
/arch/                    @OWNER
/scripts/                 @OWNER

# Verification: what journeys can do, their compiler settings, and what the installer smoke tests check
/apps/desktop/journeys/support/        @OWNER
/apps/desktop/journeys/tsconfig.json   @OWNER
/apps/desktop/journeys/smoke.json      @OWNER

# Not owned, because every feature edits them: feature-map/, the journeys (apps/desktop/journeys/*.journey.ts),
# packages/fixtures/, the composition roots (apps/desktop/src/, apps/web/src/main.tsx) and pnpm-lock.yaml (a new
# package adds itself; the deps gate checks every package's source and license, the arch gate each role's packages).
# The verify gate fails if a journey or feature the base branch has is gone, unless arch/retired.toml lists it.
